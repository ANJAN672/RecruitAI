# ──────────────────────────────────────────────────────────────────
# AI provider — set at least ONE key. Providers are tried in order:
#   1. OpenAI     (OPENAI_API_KEY)
#   2. Gemini     (GEMINI_API_KEY)
#   3. OpenRouter (OPENROUTER_API_KEY)
# If a configured provider fails at runtime, the next one is used.
# ──────────────────────────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# Gemini
# GEMINI_API_KEY="your_gemini_api_key"
# GEMINI_MODEL="gemini-2.0-flash"

# OpenRouter
# OPENROUTER_API_KEY="your_openrouter_api_key"
# OPENROUTER_MODEL="google/gemini-2.0-flash"

# ──────────────────────────────────────────────────────────────────
# Supabase — required. Used by the browser, server, and middleware
# Supabase clients. The anon key is safe to expose; Row Level Security
# protects the data.
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Optional — sent as the HTTP-Referer header on OpenRouter requests.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
